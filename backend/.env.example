# NEXORA AICTE backend environment configuration.
# Copy to backend/.env and set a locally generated JWT secret. Never commit .env.

# Database (SQLite for the prototype; point at Postgres/Supabase for production).
DATABASE_URL=sqlite:///./nexora.db

# APP_ENV=production disables interactive API documentation.
APP_ENV=development

# Required: use at least 32 random characters; the API refuses to start without it.
JWT_SECRET=
JWT_ALG=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS origins (comma-separated). The Vite dev server runs on http://localhost:5173.
CORS_ORIGINS=http://localhost:5173

# SMTP / email. When SMTP_HOST is empty, email notifications are reported as
# "unconfigured" and only in-app notifications are sent.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
