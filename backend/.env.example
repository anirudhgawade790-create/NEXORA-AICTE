# NEXORA AICTE backend environment configuration.
# Copy to backend/.env and set a locally generated JWT secret. Never commit .env.

# Database. For PostgreSQL use postgresql+psycopg://user:password@host:5432/nexora.
# SQLite is for local prototype use only.
DATABASE_URL=sqlite:///./nexora.db

# APP_ENV=production disables interactive API documentation.
APP_ENV=development

# Required: use at least 32 random characters; the API refuses to start without it.
JWT_SECRET=
JWT_ALG=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS origins (comma-separated). The Vite dev server runs on http://localhost:5173.
CORS_ORIGINS=http://localhost:5173

# SMTP / email. Password recovery requires SMTP_HOST and SMTP_FROM (or SMTP_USER).
# When SMTP_HOST is empty, email notifications remain in-app only and reset
# requests report that password recovery is unavailable.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
FRONTEND_BASE_URL=http://localhost:5173

# Optional hosted conversational assistant. Keep the provider key server-side;
# user messages are sent to OpenAI only when this is configured.
AI_CHAT_API_KEY=
AI_CHAT_MODEL=gpt-4o-mini

# Optional public institution-data integration. Only configure this after
# verifying that the resource is an official AICTE dataset and the API terms
# permit this access. Never put API keys in frontend code or commit .env.
AICTE_OGD_API_KEY=
AICTE_OGD_RESOURCE_ID=
AICTE_DATASET_PAGE_URL=
# Set true only after verifying the dataset is published by AICTE and is
# authorized for API access. Dataset URL must be an official HTTPS page.
AICTE_OGD_PUBLISHER_VERIFIED=false
AICTE_SYNC_INTERVAL_MINUTES=360
